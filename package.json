{
  "name": "goquant_auto_asse",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "test:all": "npx playwright test --reporter=html",
    "test:chrome": "npx playwright test --project=chromium --reporter=html --output=chrome_results",
    "test:firefox": "npx playwright test --project=firefox --reporter=html --output=firefox_results",
    "test:safari": "npx playwright test --project=webkit --reporter=html --output=webkit_results",
    "test:generatereports": "npx playwright test --reporter=json,html && node GQ_Assessment_Report/generateReport.ts",
    "test:report": "npx playwright test --reporter=json,html --output=playwright-report > /Users/darsh_cf/Desktop/DN_cypress/GoQuant_Auto_Asse/test-results/results.json",
    "test:reportcopy": "npx playwright test --reporter=html && node copyReport.ts",
    "test": "npx playwright test --reporter=html",
    "publish": "node copyReport.ts",
    "test:modules": "node generateModuleReports.ts",
    "dashboard": "node generateDashboard.ts",
    "build": "tsc",
    "tests": "npx playwright test",
    "report:auth": "npx playwright test tests/auth --reporter html --output docs/auth",
    "report:account": "npx playwright test tests/account --reporter html --output docs/account",
    "report:orders": "npx playwright test tests/orders --reporter html --output docs/orders",
    "report:assets": "npx playwright test tests/assets --reporter html --output docs/assets",
    "report:a11y": "npx playwright test tests/assets --reporter html --output docs/assets",
    "report:all": "npm run report:auth && npm run report:account && npm run report:orders && npm run report:assets && npm run generate:dashboard"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.9.2",
    "axe-core": "^4.11.0",
    "fs-extra": "^11.3.2",
    "ts-node": "^10.9.1",
    "typescript": "5.4"
  },
  "dependencies": {
    "make-error": "^1.3.6",
    "markdown-pdf": "^11.0.0",
    "playwright": "^1.56.1"
  }
}
